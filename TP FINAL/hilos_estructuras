#include <stdio.h>
#include <stdlib.h>
#include <pthread.h>

// 1. Definir la estructura
typedef struct {
    int id;
    char mensaje[50];
} DatosHilo;

// 2. Función que ejecutará el hilo
void* mi_funcion_hilo(void* arg) {
    // Convertir el puntero genérico void* al tipo de la estructura
    DatosHilo* datos = (DatosHilo*)arg;
    
    printf("Hilo %d ejecutado. Mensaje: %s\n", datos->id, datos->mensaje);
    
    pthread_exit(NULL);
}

int main() {
    pthread_t hilo;
    
    // 3. Crear e inicializar la estructura
    DatosHilo mis_datos;
    mis_datos.id = 1;
    snprintf(mis_datos.mensaje, sizeof(mis_datos.mensaje), "Hola desde el hilo principal");

    // 4. Crear el hilo y pasar la estructura por referencia (usando &)
    if (pthread_create(&hilo, NULL, mi_funcion_hilo, (void*)&mis_datos) != 0) {
        perror("Error al crear el hilo");
        return 1;
    }

    // Esperar a que el hilo termine
    pthread_join(hilo, NULL);
    printf("Hilo terminado correctamente.\n");

    return 0;
}
